# Copy to .env for local tests (vercel dev) and set the same names in Vercel > Settings > Environment Variables.

# Client: Cloudflare dashboard > Turnstile > your widget > Site key.
# Local-only dummy that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Server: same widget > Secret key.
# Local-only dummy that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Server: `turso db show <db-name> --url` (libsql://...). For a local file use file:local.db
TURSO_DATABASE_URL=

# Server: `turso db tokens create <db-name>`. Not needed for a file: URL.
TURSO_AUTH_TOKEN=
